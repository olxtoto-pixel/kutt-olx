<tr id="tr-{{id}}" {{#if swap_oob}}hx-swap-oob="true"{{/if}}>
<td>
  <label font-size="14,15" class="sc-AykKC sc-AykKD jGqddX" style="cursor: pointer;"><input name="{{ id }}" type="checkbox" width="0" height="0" opacity="0" class="sc-AykKC sc-AykKD Input__CheckboxInput-sc-1u39ir1-2 bryDAE percheckbox"><div width="15,16" height="15,16" class="sc-AykKC sc-AykKD Input__CheckboxBox-sc-1u39ir1-3 ldGqXr"></div><span color="#555" class="sc-AykKC Text-sc-9gh1w5-0 henEeO"></span></label>
</td>
  <td class="original-url right-fade">
    <a href="{{target}}" target="_blank" rel="noopener noreferrer">
      {{target}}
    </a>
    {{#if description}}
      <p class="description">
        {{description}}
      </p>
    {{/if}}
  </td>
  <td class="created-at">
    {{relative_created_at}}
    {{#if relative_expire_in}}
      <p class="description">
        Expires in {{relative_expire_in}}
      </p>
    {{/if}}
  </td>
  <td class="short-link right-fade">
    <div class="clipboard small">
      <button 
        aria-label="Copy" 
        hx-on:click="handleShortURLCopyLink(this);"
        data-url="{{link.url}}"
      >
        {{> icons/copy}}
      </button>
      {{> icons/check}}
    </div>
    <a href="{{link.url}}" target="_blank" rel="noopener noreferrer">
      {{link.link}}
    </a>
  </td>
  <td class="views">
    {{visit_count}}
  </td>
      <td class="additionaltd" style="display: none; flex: 3 3 0; justify-content: flex-end; overflow: visible;">
        &nbsp;
      </td>

    {{> links/actions}}
</tr>
<tr class="edit">
  <td class="loading">
    {{> icons/spinner}}
  </td>
</tr>